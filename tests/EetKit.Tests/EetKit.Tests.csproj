<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- .NET Framework runs only on Windows; elsewhere it is compiled on request (-p:EetNetFramework=true). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' Or '$(EetNetFramework)' == 'true'">$(TargetFrameworks);net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <!-- The SDK adds this implicit using only for .NET (Core). -->
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EetKit\EetKit.csproj" />
    <ProjectReference Include="..\..\src\EetKit.Extensions.DependencyInjection\EetKit.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\spec\*.zip;..\..\docs\spec\*.xsd;..\..\docs\spec\*.xml" Link="spec\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
